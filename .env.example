# Keep real credentials in .env. Never commit .env to source control.
PORT=3002
CLIENT_ORIGIN=http://localhost:5175
JWT_SECRET=replace-with-a-long-random-secret

# Demo mode starts with an in-memory campus dataset and needs no database.
DEMO_MODE=true

# Set DEMO_MODE=false and provide a database to use MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=campus_queue_manager

# Optional SMS notifications (Twilio). Without these, the app still works
# and shows queue updates in the browser.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
